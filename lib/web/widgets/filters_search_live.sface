<nav>
  {#case @search}
    {#match term when is_binary(term) and term != ""}
      {!-- the result-type tabs, in the same lined style as profile/group pages; the
           full-width rule sits on a wrapper so the underlines meet it --}
      <Bonfire.UI.Common.TabsLive
        class="px-0 flex justify-between w-full tabs border-b border-secondary"
        tab_class="flex flex-1 pt-3 text-base hover:bg-base-content/5 place-content-center lined_tab [&.active>div]:border-primary [&.active>div]:text-base-content"
        item_class="text-muted text-sm pb-3 border-b-2 border-transparent font-medium"
        tabs={Bonfire.Search.UI.FiltersSearchLive.tabs(term, @index, @filters)}
        selected_tab={Bonfire.Search.UI.FiltersSearchLive.active_tab_url(@selected_tab, term, @index, @filters)}
      />
    {#match _}
      {!-- no query yet: no result-type tabs to show --}
  {/case}

  <div
    :if={@selected_tab == "Bonfire.Data.Social.Post"}
    class="flex p-4 border-b border-secondary py-2 items-center justify-between"
  >
    <div class="text-sm font-medium">{l("Results")}</div>

    <Dropdown
      id="search_boundary"
      position="bottom-end"
      trigger_class={"btn-soft btn btn-sm", "btn-warning": @index != "public"}
      label={l("Search visibility")}
    >
      <:trigger>
        {#if @index == "public"}
          <#Icon iconify="ph:lock-simple-open-duotone" class="w-4 h-4 opacity/70" />
          {l("Public only")}
        {#else}
          <#Icon iconify="ph:detective-duotone" class="w-4 h-4 opacity/70" />
          {l("Private included")}
        {/if}
      </:trigger>
      <li>
        <button
          role="tab"
          class="flex gap-3 px-2 text-base-content justify-between items-center"
          phx-click="toggle_index"
          phx-value-index="public"
        >{l("Public only")}
          <div class="w-5 h-5 flex items-center justify-center border border-secondary rounded-full">
            <span :if={@index == "public"} class="w-[14px] h-[14px] bg-primary rounded-full" />
          </div>
        </button>
      </li>
      <li>
        <button
          role="tab"
          class="flex gap-3 px-2 text-base-content justify-between items-center"
          phx-click="toggle_index"
          phx-value-index="closed"
        >
          {l("Private (eg. DMs or custom boundaries)")}
          <div class="w-5 h-5 min-w-5 flex items-center justify-center border border-secondary rounded-full">
            <span :if={@index != "public"} class="w-[14px] h-[14px] bg-primary rounded-full" />
          </div>
        </button>
      </li>
    </Dropdown>
  </div>
</nav>
