<nav>
  {#case @search}
    {#match term when is_binary(term) and term != ""}
      {!-- the result-type tabs, in the same lined style as profile/group pages; the
           full-width rule sits on a wrapper so the underlines meet it --}
      <Bonfire.UI.Common.TabsLive
        class="px-0 flex justify-between w-full tabs border-b border-divider"
        tab_class="flex flex-1 pt-3 text-base hover:bg-fill place-content-center lined_tab [&.active>div]:border-primary [&.active>div]:text-base-content"
        item_class="text-muted text-sm pb-3 border-b-2 border-transparent font-medium"
        tabs={Bonfire.Search.UI.FiltersSearchLive.tabs(term, @index, @filters)}
        selected_tab={Bonfire.Search.UI.FiltersSearchLive.active_tab_url(@selected_tab, term, @index, @filters)}
      />
    {#match _}
      {!-- no query yet: no result-type tabs to show --}
  {/case}

  {!-- on All and Groups too, where groups show: a members-only group is in the closed index only --}
  <div
    :if={@selected_tab in [nil, Bonfire.Search.Filters.groups_tab(), Bonfire.Search.Filters.posts_tab()]}
    class="flex p-4 border-b border-divider py-2 items-center justify-between gap-3"
  >
    <div class="text-sm font-medium">{l("Results")}
      {!-- the private side searches the closed index only, so say where the public results are --}
      <span
        :if={@index != "public"}
        data-role="search_boundary_hint"
        class="block text-xs font-normal text-muted"
      >{l("Public results are under \"Public only\".")}</span>
    </div>

    <Dropdown
      id="search_boundary"
      position="bottom-end"
      trigger_class={"btn-soft btn btn-sm", "btn-warning": @index != "public"}
      label={l("Search visibility")}
    >
      <:trigger>
        {#if @index == "public"}
          <#Icon iconify="ph:lock-simple-open-duotone" class="size-4 opacity/70" />
          {l("Public only")}
        {#else}
          <#Icon iconify="ph:detective-duotone" class="size-4 opacity/70" />
          {l("Private only")}
        {/if}
      </:trigger>
      <li>
        <button
          role="tab"
          class="flex gap-3 px-2 text-base-content justify-between items-center"
          phx-click="toggle_index"
          phx-value-index="public"
        >{l("Public only")}
          <div class="size-5 flex items-center justify-center border border-divider rounded-full">
            <span :if={@index == "public"} class="size-3.5 bg-primary rounded-full" />
          </div>
        </button>
      </li>
      <li>
        <button
          role="tab"
          class="flex gap-3 px-2 text-base-content justify-between items-center"
          phx-click="toggle_index"
          phx-value-index="closed"
        >
          {l("Private only (eg. DMs, members-only groups or custom boundaries)")}
          <div class="size-5 min-w-5 flex items-center justify-center border border-divider rounded-full">
            <span :if={@index != "public"} class="size-3.5 bg-primary rounded-full" />
          </div>
        </button>
      </li>
    </Dropdown>
  </div>
</nav>
