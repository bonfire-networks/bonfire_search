<div
  id="the_search_results"
  phx-update="replace"
  data-page={e(@page, [])}
>
  {#if @searching && e(@hits, []) == [] && e(@user_hits, []) == []}
    <div class="flex items-center justify-center py-8">
      <span class="loading loading-spinner loading-md" />
    </div>
  {#elseif @searching_direct && (e(@hits, []) != [] || e(@user_hits, []) != [])}
    <div class="flex items-center justify-center py-2 text-sm text-muted">
      <span class="loading loading-spinner loading-xs mr-2" />
      {if String.starts_with?(@search || "", "http"),
        do: l("Searching for a matching federated activity..."),
        else: l("Searching for a matching federated profile...")}
    </div>
  {/if}

  {#if Bonfire.Search.Filters.typed_tab?(@selected_tab)}
    {!-- Type-specific tab: show full list with pagination --}

    {#if @selected_tab == Bonfire.Search.Filters.people_tab()}
      <div class="divide-hair divide-secondary">
        {#for user <- e(@user_hits, [])}
          <div>
            <StatelessComponent
              module={maybe_component(Bonfire.UI.Me.Preview.CharacterLive, @__context__)}
              activity_component_id={"search-user-#{id(user)}"}
              showing_within={:search}
              wrapper_class="p-card"
              object={user}
            />
          </div>
        {#else}
          {#if !@searching}
            <Bonfire.UI.Common.EmptyFeed feedback_title={l("No users found")} feedback_message="" />
          {/if}
        {/for}
      </div>
    {#else}
      {!-- same wrapper as feed entries, so padding and dividers follow the UI preset --}
      {#for hit <- e(@hits, [])}
        <div class="activity_wrapper">
          <StatefulComponent
            module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
            id={deterministic_dom_id(__MODULE__, e(hit, :activity, :id, nil) || id(hit), "search_activity", nil)}
            showing_within={:search}
            activity={e(hit, :activity, nil) || hit}
          />
        </div>
      {#else}
        {!-- a filtered page can come back empty while later candidates still match: leave that to "Load more" --}
        {#if !@searching && !e(@page_info, :has_next_page, false)}
          <Bonfire.UI.Common.EmptyFeed feedback_title={l("No posts found")} feedback_message="" />
        {/if}
      {/for}
    {/if}
  {#else}
    {!-- "All" tab: an overview. People first (a few), then posts; each group ends
         with a quiet "See all" row that opens the corresponding tab. No icons. --}

    {#if e(@user_hits, []) == [] && e(@hits, []) == [] && !@searching &&
        !e(@page_info, :has_next_page, false)}
      <Bonfire.UI.Common.EmptyFeed
        feedback_title={l("Nothing relevant was found")}
        feedback_message=""
      />
    {#else}
      {#if e(@user_hits, []) != []}
        {!-- people as a compact strip above the posts: visually distinct, so neither
             group needs a heading; the strip scrolls sideways and ends in "See all" --}
        <div
          class="flex items-center gap-2 overflow-x-auto px-4 py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-role="search_people_strip"
        >
          {#for user <- Enum.take(e(@user_hits, []), Bonfire.Search.LiveHandler.overview_people_limit())}
            <LinkLive
              to={path(user)}
              opts={["data-role": "character"]}
              class="flex items-center gap-2 shrink-0 max-w-[240px] min-h-11 pl-1.5 pr-3 rounded-full bg-base-content/5 hover:bg-base-content/10 transition-colors duration-150"
            >
              <Bonfire.UI.Common.AvatarLive
                src={Bonfire.Common.Media.avatar_url(user)}
                user_id={id(user)}
                parent_id="search_people_strip"
                wrapper_class="avatar !flex shrink-0"
                class="w-8 h-8 rounded-full bg-base-100"
              />
              <span class="min-w-0 leading-tight">
                <span data-id="profile_name" class="block text-sm font-medium text-base-content truncate">{e(user, :profile, :name, nil) || e(user, :character, :username, nil)}</span>
                <span class="block text-xs text-muted truncate">@{e(user, :character, :username, nil)}</span>
              </span>
            </LinkLive>
          {/for}
          {!-- the strip holds at most overview_people_limit people; a full strip means there may be more --}
          <LinkPatchLive
            :if={length(e(@user_hits, [])) >= Bonfire.Search.LiveHandler.overview_people_limit()}
            to={Bonfire.Search.Filters.tab_url(@search, @index, %{}, Bonfire.Search.Filters.people_tab())}
            class="flex items-center gap-1 shrink-0 min-h-11 px-3 rounded-full text-sm text-primary hover:bg-base-content/5"
          >
            <span>{l("See all people")}</span>
            <span aria-hidden="true">›</span>
          </LinkPatchLive>
        </div>
      {/if}

      {#if e(@hits, []) != []}
        <div class="border-t-hair border-secondary">
          {#for hit <- Enum.take(e(@hits, []), 5)}
            <div class="activity_wrapper">
              <StatefulComponent
                module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
                id={deterministic_dom_id(__MODULE__, e(hit, :activity, :id, nil) || id(hit), "search_activity", nil)}
                showing_within={:search}
                activity={e(hit, :activity, nil) || hit}
              />
            </div>
          {/for}
        </div>
      {/if}
      {#if length(e(@hits, [])) > 5 or e(@page_info, :has_next_page, false)}
        <LinkPatchLive
          to={Bonfire.Search.Filters.tab_url(@search, @index, %{}, Bonfire.Search.Filters.posts_tab())}
          class="flex items-center justify-between min-h-11 px-4 text-sm text-primary hover:bg-base-content/5"
        >
          <span>{l("See all posts")}</span>
          <span aria-hidden="true">›</span>
        </LinkPatchLive>
      {/if}
    {/if}
  {/if}

  {!-- type-specific tabs paginate here; the All tab hands off to "See all" rows instead --}
  <Bonfire.UI.Common.LoadMoreLive
    :if={@page_info && Bonfire.Search.Filters.typed_tab?(@selected_tab)}
    page_info={@page_info}
    live_handler="Bonfire.Search.LiveHandler"
    context="search"
    hide_guest_fallback={false}
    hide_if_no_more
  >
    <:if_no_more>
      <p class="text-center text-muted py-4">{l("That's all the search results!")}</p>
    </:if_no_more>
  </Bonfire.UI.Common.LoadMoreLive>
</div>
